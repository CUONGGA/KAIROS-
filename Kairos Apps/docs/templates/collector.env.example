# Developer-machine configuration for the Codex collector. Never commit the real file.
export KAIROS_FRAPPE_URL="http://127.0.0.1:8001"
export KAIROS_FRAPPE_TOKEN="<frappe-api-key>:<frappe-api-secret>"
export KAIROS_CODEX_SESSIONS_DIR="/mnt/c/Users/<windows-user>/.codex/sessions"
export KAIROS_CODEX_BATCH_SIZE="100"
export KAIROS_CODEX_TIMEOUT="120"
